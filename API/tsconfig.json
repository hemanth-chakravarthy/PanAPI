{
  "compilerOptions": {
    "target": "ES2020",                       // Modern JS features
    "module": "CommonJS",                     // Required for Node.js compatibility
    "moduleResolution": "node",               // Properly resolves node_modules
    "rootDir": "./",                          // Source files location
    "outDir": "./dist",                       // Output JS build directory
    "strict": true,                           // Enable all strict type-checking
    "esModuleInterop": true,                  // Allow default imports from CommonJS
    "allowSyntheticDefaultImports": true,     // For smoother import of default exports
    "resolveJsonModule": true,                // Allow importing JSON files as modules
    "forceConsistentCasingInFileNames": true, // Avoid cross-platform path issues
    "noImplicitAny": true,                    // Disallow implicit `any` type
    "skipLibCheck": true                      // Skip type checking of .d.ts files
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
